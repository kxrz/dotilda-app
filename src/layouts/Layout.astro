---
import '../styles/global.css';
import { locales, pathFor, t } from '../i18n';

// The landing page in each language, or another page (path given) that exists in English only.
interface Props { locale: string; path?: string; title?: string; description?: string; noindex?: boolean }
const { locale, path, noindex } = Astro.props;
const s = t(locale);
const site = Astro.site!.origin;
const url = site + (path ?? pathFor(locale));
const title = Astro.props.title ?? s.meta.title;
const description = Astro.props.description ?? s.meta.description;
const ogDescription = Astro.props.description ?? s.meta.ogDescription;
const image = `${site}/og/${locale}.png`; // drawn per language by scripts/og.mjs
const repo = 'https://github.com/kxrz/dotilda-app';

// Structured data for search engines and AI answer engines: the site, and the app it presents.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': site + '/#website',
      url: site + '/',
      name: 'Dotilda',
      inLanguage: locales,
      publisher: { '@id': 'https://readme.club/#organization' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://readme.club/#organization',
      name: 'readme.club',
      url: 'https://readme.club',
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.leswww.com/#organization',
      name: 'LesWWW',
      url: 'https://www.leswww.com',
    },
    {
      '@type': 'MobileApplication',
      '@id': site + '/#app',
      name: 'Dotilda',
      alternateName: 'Dotilda journal',
      description: s.meta.appDescription,
      url: site + '/',
      image,
      applicationCategory: 'LifestyleApplication',
      applicationSubCategory: 'Journaling',
      operatingSystem: 'Android 11+',
      availableOnDevice: 'Android 11+ phones, tablets and e-readers; designed first for the Mudita Kompakt',
      downloadUrl: repo + '/releases/latest/download/dotilda.apk',
      installUrl: repo + '/releases/latest',
      softwareHelp: repo + '#readme',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      publisher: { '@id': 'https://readme.club/#organization' },
      creator: { '@id': 'https://www.leswww.com/#organization' },
      maintainer: { '@id': 'https://www.leswww.com/#organization' },
      inLanguage: ['en', 'pl'], // the app itself (it follows the phone's language); the site is translated
      sameAs: [repo],
    },
    !path && {
      '@type': 'FAQPage',
      '@id': url + '#faq',
      inLanguage: locale,
      mainEntity: s.faq.items.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ].filter(Boolean),
};
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={url}>
{!path && locales.map(l => <link rel="alternate" hreflang={l} href={site + pathFor(l)} />)}
{!path && <link rel="alternate" hreflang="x-default" href={site + '/'} />}
<meta name="theme-color" content="#FBFAF6" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#151513" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Dotilda">
<meta property="og:locale" content={s.meta.ogLocale}>
{!path && locales.filter(l => l !== locale).map(l => <meta property="og:locale:alternate" content={t(l).meta.ogLocale} />)}
<meta property="og:url" content={url}>
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={image}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={s.meta.ogImageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={image}>
<meta name="twitter:image:alt" content={s.meta.ogImageAlt}>
<link rel="sitemap" href="/sitemap.xml">
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
<link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline src="/theme.js"></script>
<script is:inline src="/motion.js"></script>
</head>
<body>
<slot />
</body>
</html>
