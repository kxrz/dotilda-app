---
import DotildaMark from './DotildaMark.astro';
import Words from './Words.astro';
import { glyphs } from '../glyphs';
import { locales, pathFor, t } from '../i18n';
import lesWWW from '../assets/leswww-logo.svg?raw';

interface Props { locale: string }
const { locale } = Astro.props;
const s = t(locale);
const repo = 'https://github.com/kxrz/dotilda-app';
// One tap adds Dotilda to Obtainium (the redirect page opens the obtainium:// link on Android).
const obtainium = `https://apps.obtainium.imranr.dev/redirect?r=obtainium://add/${repo}`;
// Where beta testers talk back. Leave reddit empty to hide its link.
const feedback = { github: `${repo}/issues/new`, reddit: 'https://www.reddit.com/u/iamkxrz/' };

// What the browser script needs, as data (the CSP runs no inline script).
const pageData = {
  dateLocale: s.dateLocale,
  hero: { sample: s.hero.sample, noted: s.hero.noted, after: s.hero.after, privacy: s.hero.privacy, asks: s.hero.asks, quips: s.hero.quips,
    demo: s.hero.demo, placeholder: s.hero.placeholder, word: s.hero.word, justWeather: s.hero.justWeather, yourTurn: s.hero.yourTurn, nextDay: s.hero.nextDay,
    weatherLabels: s.hero.weatherLabels, weatherPhrases: s.hero.weatherPhrases },
  questions: s.questions,
  try: s.try,
  get: { downloadVersion: s.get.downloadVersion, line: s.get.line },
};

---
<a class="skip" href="#ritual">{s.nav.skip}</a>
<div class="wrap">

<header class="top">
  <a class="brand" href={pathFor(locale)} aria-label={s.nav.home}>
    <DotildaMark class="brand-mark" />
    Dotilda <small>{s.nav.by}</small>
  </a>
  <nav class="top" aria-label={s.nav.sections}>
    <a class="hide-s" href="#ritual">{s.nav.ritual}</a>
    <a class="hide-s" href="#sky">{s.nav.sky}</a>
    <a class="hide-s" href="#faq">{s.nav.faq}</a>
    <a class="nav-get" href="#get">{s.nav.get}</a>
    <button class="theme-toggle" type="button" id="themeToggle" aria-label={s.nav.toDark} data-to-dark={s.nav.toDark} data-to-light={s.nav.toLight}>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    {locales.length > 1 && (
      <span class="langs" aria-label={s.nav.language}>
        {locales.map(l => l === locale
          ? <b aria-current="page">{l.toUpperCase()}</b>
          : <a href={pathFor(l)} hreflang={l} lang={l} title={t(l).language}>{l.toUpperCase()}</a>)}
      </span>
    )}
  </nav>
</header>

<main>
<!-- Attention: Dotilda asks, right here. Answer, and watch your dot land in the year. -->
<div class="hero" id="top">
  <div class="hero-in">
    <p class="label" data-reveal="hero">{s.hero.kicker}</p>
    <h1 data-hero-title>{s.hero.headline.split(/(?<=\.) /).map(line => <span class="line">{line.split(' ').map(w => <><span class="w">{w}</span>{' '}</>)}</span>)}</h1>
    <p class="hero-lede" data-reveal="hero">{s.hero.lede}</p>

    <!-- Dotilda's playground: she asks in her bubble, as in the app; answer in a line, a word, a
         choice or a moon, change the question, go on to the next day. Poke her: she plays along. -->
    <div class="stage">
      <div class="dotilda" data-reveal="hero">
        <button class="poke" id="poke" type="button" aria-label={s.hero.poke}><DotildaMark pose="peering" class="hero-mark" /></button>
        <span class="poke-hint label" id="pokeHint" hidden>{s.hero.pokeHint}</span>
      </div>
      <p class="label ask-who" id="askWho" aria-live="polite" data-reveal="hero">{s.hero.asks}</p>
      <div class="bubble" data-reveal="hero">
        <p class="ask-q" id="askQ" aria-live="polite"><span class="sr-only">{s.hero.question}</span><span aria-hidden="true" class="ask-chars">{s.hero.question.split(' ').map(w => <><span class="cw">{[...w].map(c => <span class="c">{c}</span>)}</span>{' '}</>)}</span></p>
      </div>
      <form class="ask" id="ask" autocomplete="off" data-kind="line">
        <div class="ask-field" data-reveal="hero">
          <label class="sr-only" for="askInput" id="askLabel">{s.hero.question}</label>
          <textarea id="askInput" name="answer" rows="1" maxlength="140" enterkeyhint="done" placeholder={s.hero.placeholder}></textarea>
          <button class="btn solid" type="submit" id="askBtn">{s.hero.submit}</button>
        </div>
        <div class="choices" id="choices"></div>
        <div class="moons" id="moons"></div>
        <p class="ask-note" id="askNote" data-reveal="hero">{s.hero.privacy}</p>
        <div class="ask-more" data-reveal="hero">
          <button class="link-btn" type="button" id="another">{s.try.another.replace('{n}', '3')}</button>
          <button class="btn turn" type="button" id="nextDay" hidden>{s.hero.yourTurn}</button>
        </div>
      </form>
    </div>

    <!-- This month, as on the app's Today screen: answered days in ink, quiet days small, today waiting under its caret. -->
    <div class="month" data-reveal="hero" aria-hidden="true">
      <span class="label" id="monthName"></span>
      <svg id="monthDots" preserveAspectRatio="xMinYMid meet"></svg>
    </div>
  </div>
</div>

<!-- After the playground: a big ink card that says what the buttons do, then the buttons.
     Dotilda watches the main one, and smiles when you reach for it. -->
<section class="cta after-hero" id="start">
  <div class="cta-card" data-anim="cta-card">
    <div class="cta-head">
      <p class="label">{s.cta.label}</p>
      <DotildaMark pose="peering" class="cta-mark" />
    </div>
    <h2 class="cta-title" data-split><Words text={s.cta.title} /></h2>
    <ol class="cta-facts">
      {s.cta.facts.map((f, i) => (
        <li data-anim="cta-fact"><span class="cta-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><b>{f.title}</b><p>{f.text}</p></li>
      ))}
    </ol>
    <div class="actions" data-anim="cta-actions">
      <a class="btn cta-main" id="heroGet" href="#get">{s.hero.primary}</a>
      <a class="cta-link" href="#ritual">{s.hero.secondary}</a>
    </div>
    <p class="cta-note" data-anim="cta-actions">{s.hero.note}</p>
    {s.appLanguage && <p class="lang-note cta-note" data-anim="cta-actions"><span class="lang-pill" translate="no">{s.appLanguagePill}</span>{s.appLanguage}</p>}
  </div>
</section>

<!-- Interest: the ritual in three steps -->
<section id="ritual">
  <div class="stack">
    <p class="label">{s.ritual.label}</p>
    <h2 data-split><Words text={s.ritual.title} /></h2>
  </div>
  <div class="cols">
    {s.ritual.steps.map(step => (
      <div class="step" data-anim="step">
        <span class="rule" aria-hidden="true"></span>
        <span class="label">{step.label}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </div>
    ))}
  </div>
</section>

<!-- Interest: real screens of the released app, as they are on the Kompakt -->
<section id="inside">
  <div class="stack">
    <p class="label">{s.inside.label}</p>
    <h2 data-split><Words text={s.inside.title} /></h2>
    <p class="lede">{s.inside.lede}</p>
  </div>
  <div class="carousel">
    <div class="track" id="track" tabindex="0" role="region" aria-roledescription="carousel" aria-label={s.inside.label}>
      {s.inside.screens.map((sc, i) => (
        <figure class:list={['slide', { active: i === 0 }]} data-anim="page">
          <span class="page"><img src={`/app/${sc.src}.png`} width="479" height="750" alt={sc.caption} loading={i < 3 ? 'eager' : 'lazy'} decoding="async"></span>
          <figcaption aria-hidden="true">{sc.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="carousel-nav">
      <button class="page-key" type="button" id="prevShot" aria-label={s.inside.prev}>‹</button>
      <span class="count" id="shotCount" aria-live="polite">1 / {s.inside.screens.length}</span>
      <button class="page-key" type="button" id="nextShot" aria-label={s.inside.next}>›</button>
    </div>
  </div>
</section>

<!-- Interest: the eight ways to answer, and a few more questions to try -->
<section id="shapes">
  <div class="stack">
    <p class="label">{s.shapes.label}</p>
    <h2 data-split><Words text={s.shapes.title} /></h2>
  </div>
  <ul class="formats">
    {s.shapes.formats.map(f => (
      <li class="fmt" data-anim="fmt">
        <svg viewBox="0 0 22 22" aria-hidden="true" set:html={glyphs[f.shape] ?? glyphs.full} />
        <b>{f.name}{'soon' in f && f.soon && <em class="soon">{s.shapes.soon}</em>}</b><span>{f.text}</span>
      </li>
    ))}
  </ul>

  <div class="try">
    <div class="try-head">
      <DotildaMark pose="peering" class="try-mark" />
      <p class="label">{s.try.label}</p>
    </div>
    <p class="q" id="tryQ" aria-live="polite">{s.try.first}</p>
    <div class="actions">
      <button class="btn" type="button" id="tryBtn">{s.try.another.replace('{n}', '3')}</button>
    </div>
    <p class="meta" id="tryMeta">{s.try.meta}</p>
  </div>
</section>

<!-- Desire: a pause, one huge sentence inked word by word as you scroll -->
<section class="pause">
  <p class="pause-text" data-pause><Words text={s.pause.text} /><DotildaMark pose="peering" class="pause-mark" /></p>
</section>

<!-- Desire: the year of dots, Dotilda's voice, the promises -->
<section id="sky">
  <div class="split">
    <div class="stack">
      <p class="label">{s.sky.label} · <span id="skyYear">{new Date().getFullYear()}</span></p>
      <h2 data-split><Words text={s.sky.title} /></h2>
      <p class="lede">{s.sky.lede}</p>
    </div>
    <div class="quotes">
      {s.sky.quotes.map(q => (
        <figure data-anim="quote"><p class="voice">“{q.text}”</p><figcaption>{q.who}</figcaption></figure>
      ))}
    </div>
  </div>

  <figure class="galaxy">
    <div class="months" aria-hidden="true">{s.sky.months.map(m => <span>{m}</span>)}</div>
    <canvas id="galaxy" role="img" aria-label={s.sky.aria}></canvas>
    <figcaption>
      <span><i class="k-ink"></i>{s.sky.legend.answer}</span>
      <span><i class="k-ghost"></i>{s.sky.legend.quiet}</span>
      <span><i class="k-today"></i>{s.sky.legend.today}</span>
      <span>{s.sky.legend.journey}</span>
    </figcaption>
  </figure>

  <ul class="promises">
    {s.promises.map(p => <li data-anim="promise"><b>{p.title}</b><span>{p.text}</span></li>)}
  </ul>
  {s.coming.text && <p class="coming" data-anim="promise"><span class="label">{s.coming.label}</span> {s.coming.text}</p>}
</section>

<!-- Action: install the beta -->
<section id="get">
  <div class="get-grid">
  <div class="get">
    <div class="stack">
      <p class="label">{s.get.label}</p>
      <h2 data-split><Words text={s.get.title} /></h2>
    </div>
    <p class="lang-note" data-anim="how"><span class="lang-pill">{s.get.betaTag}</span>{s.get.beta}</p>
    {s.appLanguage && <p class="lang-note" data-anim="how"><span class="lang-pill" translate="no">{s.appLanguagePill}</span>{s.appLanguage}</p>}
    <ol class="how">
      {s.get.ways.map((way, i) => (
        <li data-anim="how"><div>
          <b>{way.title}</b><br><span>{way.text}</span>
          {i === 1 && <><br><a class="quiet-link" href={obtainium}>{s.get.obtainium}</a></>}
        </div></li>
      ))}
    </ol>
    <p class="after" data-anim="how">{s.get.after}</p>
    <div class="actions" data-anim="actions">
      <a class="btn solid" id="dl" href={`${repo}/releases/latest/download/dotilda.apk`}>{s.get.download}</a>
      <a class="btn" href={repo}>{s.get.source}</a>
      <a class="quiet-link" id="changes" href={`${repo}/releases/latest`}>{s.get.changes}</a>
    </div>
    <p class="dev" id="release">{s.get.fallback}</p>
    <p class="dev">{s.get.adb} <code>adb install dotilda.apk</code></p>
  </div>
  <figure class="device">
  <div class="kompakt" role="img" aria-label={s.get.device.aria} data-anim="device">
    <span class="k-btn k-left" aria-hidden="true"></span>
    <span class="k-btn k-right" aria-hidden="true"></span>
    <div class="k-top" aria-hidden="true"><span class="k-cam"></span><span class="k-speaker"></span></div>
    <div class="screen">
      <div class="status" aria-hidden="true">
        <svg viewBox="0 0 30 10"><path d="M1 9h2V7H1zM5 9h2V5H5zM9 9h2V3H9z"/><path d="M17 8.6a1 1 0 1 0 0 .1zM14 6.4a4.3 4.3 0 0 1 6 0M12.2 4.4a7 7 0 0 1 9.6 0" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        <svg viewBox="0 0 20 10"><rect x=".6" y=".6" width="16" height="8.8" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="2.4" y="2.4" width="10" height="5.2" rx=".6"/><rect x="17.6" y="3.4" width="1.6" height="3.2" rx=".6"/></svg>
      </div>
      <div class="shots">
        {['today', 'constellation', 'galaxy', 'review'].map((src, i) => <img src={`/app/${src}.png`} width="479" height="750" alt="" class:list={[{ on: i === 0 }]} decoding="async">)}
      </div>
    </div>
    <div class="k-nav" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M19 12H6M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5.5" fill="none" stroke="currentColor" stroke-width="2.6"/></svg>
      <svg viewBox="0 0 24 24"><path d="M9 5v5M9 14v5M15 5v5M15 14v5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
    </div>
  </div>
  <figcaption class="device-caption">{s.get.device.caption}</figcaption>
  </figure>
  </div>
</section>

<!-- Action: the questions people ask before installing -->
<section id="faq">
  <div class="stack">
    <p class="label">{s.faq.label}</p>
    <h2 data-split><Words text={s.faq.title} /></h2>
  </div>
  <div class="faq">
    {s.faq.items.map(item => (
      <details data-anim="faq"><summary>{item.q}</summary><p>{item.a}</p></details>
    ))}
  </div>
</section>

<!-- Action: beta testers talk back -->
<section id="feedback">
  <div class="stack">
    <p class="label">{s.feedback.label}</p>
    <h2 data-split><Words text={s.feedback.title} /></h2>
    <p class="lede">{s.feedback.text}</p>
  </div>
  <div class="actions" data-anim="feedback">
    <a class="btn" href={feedback.github}>{s.feedback.github}</a>
    {feedback.reddit && <a class="btn" href={feedback.reddit}>{s.feedback.reddit}</a>}
  </div>
</section>
</main>

<footer>
  <div class="credits">
    <a class="credit" href="https://readme.club"><span class="label">{s.footer.appBy}</span><span class="rmc">readme.club</span></a>
    <a class="credit www" href="https://www.leswww.com"><span class="label">{s.footer.madeBy}</span><Fragment set:html={lesWWW} /></a>
  </div>
  <p class="fine">{s.footer.fine}<br><a class="brand-link" href="/brand" hreflang="en">{s.footer.brand}</a> · <a class="brand-link" href="/stats" hreflang="en">{s.footer.stats}</a></p>
</footer>

</div>

<script type="application/json" id="page-data" is:inline set:html={JSON.stringify(pageData).replace(/</g, '\\u003c')} />
<script>
  import '../scripts/landing';
</script>
